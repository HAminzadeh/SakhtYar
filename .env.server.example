# Public
SAKHTYAR_DOMAIN=sakhtyar.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=sakhtyar
POSTGRES_USER=sakhtyar
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD

# MinIO
MINIO_ROOT_USER=sakhtyar
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=sakhtyar-documents

# App
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=مدیر سیستم

APP_JWT_SECRET=CHANGE_ME_TO_AT_LEAST_64_RANDOM_CHARACTERS
APP_JWT_EXPIRATION_MINUTES=480

# Runtime tuning
JAVA_API_OPTS=-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=30
JAVA_WORKER_OPTS=-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=20
JAVA_AGENT_OPTS=-XX:MaxRAMPercentage=75 -XX:InitialRAMPercentage=20
JAVA_COLLECTOR_OPTS=-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=20

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Optional local AI
OLLAMA_MODEL=qwen3:14b
