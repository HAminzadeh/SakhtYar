<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 targetNamespace="https://sakhtyar.ir/contracts/urban/v1"
 xmlns="https://sakhtyar.ir/contracts/urban/v1" elementFormDefault="qualified">
 <xs:element name="UrbanQuery">
  <xs:complexType>
   <xs:sequence>
    <xs:element name="Intent" type="xs:string"/>
    <xs:element name="Language" type="xs:string" minOccurs="0"/>
    <xs:element name="CaseId" type="xs:string" minOccurs="0"/>
    <xs:element name="PropertyId" type="xs:string" minOccurs="0"/>
    <xs:element name="PayloadXml" type="xs:string" minOccurs="0"/>
   </xs:sequence>
   <xs:attribute name="version" type="xs:string" use="required"/>
  </xs:complexType>
 </xs:element>
</xs:schema>
