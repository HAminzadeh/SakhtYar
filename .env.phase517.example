# Phase 5.17 reference - set real secrets in your secret manager, not Git.
# Public URLs should be configured in Caddy / your reverse proxy.
SAKHTYAR_PUBLIC_SITE_URL=https://www.example.invalid
SAKHTYAR_PUBLIC_APP_URL=https://app.example.invalid
SAKHTYAR_PUBLIC_API_URL=https://api.example.invalid
# Approved IdP / OIDC integration is NOT automatically enabled by this patch.
SAKHTYAR_OIDC_ISSUER=
SAKHTYAR_OIDC_REACT_CLIENT_ID=
SAKHTYAR_OIDC_WORDPRESS_CLIENT_ID=
# Keep Postgres/Redis/MinIO/Ollama private. No secret values belong here.