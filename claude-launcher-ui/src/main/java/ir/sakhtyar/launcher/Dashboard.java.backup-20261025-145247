package ir.sakhtyar.launcher;

import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import javafx.application.Application;
import javafx.application.Platform;
import javafx.geometry.Insets;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.*;
import javafx.stage.Stage;
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.time.LocalDateTime;
import java.util.*;

public class Dashboard extends Application {
  private final Map<String,List<String>> groups = new LinkedHashMap<>();
  private final Map<String,CheckBox> boxes = new LinkedHashMap<>();
  private final ObjectMapper json = new ObjectMapper();
  private final TextArea console = new TextArea();
  private final Label status = new Label("Not checked");
  private Path root, settings, backend;
  private volatile Process running;
  private Button launchButton, preflightButton;

  public Dashboard(){
    groups.put("Network / v2rayN",List.of("Check v2rayN process","Detect HTTP proxy port","Test proxy HTTPS","Check German exit IP","Monitor connection","Detect proxy leak","Retry connection","Set Claude proxy"));
    groups.put("Claude / API",List.of("Check Claude CLI","Check authentication","Check CCR provider","Select provider profile","Resume session","Track usage","Check versions"));
    groups.put("SakhtYar project",List.of("Verify project path","Build handoff","Check CLAUDE.md","Inspect Git changes","Protect sensitive files","Run hooks","Run Java tests","Check Java Node and npm"));
    groups.put("Management",List.of("Protect API secrets","Write logs","Create diagnostics","Show Windows notifications","Avoid duplicate launcher","Run preflight","Show dashboard status"));
  }
  @Override public void start(Stage stage){
    String path=System.getenv("SAKHTYAR_PROJECT_ROOT");
    root = Path.of((path==null || path.isBlank()) ? "." : path).toAbsolutePath().normalize();
    settings=root.resolve("_claude_launcher").resolve("launcher-settings.json");
    backend=root.resolve("claude-launcher-ui").resolve("scripts").resolve("Invoke-Claude.ps1");
    Map<String,Boolean> previous=readSettings();
    VBox categories=new VBox(9);categories.setPadding(new Insets(8));
    for(var group:groups.entrySet()){
      VBox content=new VBox(7);content.setPadding(new Insets(9));
      CheckBox groupCheckbox=new CheckBox("Enable whole category");
      content.getChildren().add(groupCheckbox);
      List<CheckBox> members=new ArrayList<>();
      for(String name:group.getValue()){
        CheckBox cb=new CheckBox(name);
        cb.setSelected(previous.getOrDefault(name,true));
        cb.setWrapText(true);members.add(cb);boxes.put(name,cb);
        content.getChildren().add(cb);
        cb.selectedProperty().addListener((obs,oldV,newV)->{
          groupCheckbox.setSelected(members.stream().allMatch(CheckBox::isSelected));
          writeSettings();
        });
      }
      groupCheckbox.setSelected(members.stream().allMatch(CheckBox::isSelected));
      groupCheckbox.setOnAction(e->members.forEach(c->c.setSelected(groupCheckbox.isSelected())));
      TitledPane pane=new TitledPane(group.getKey(),content);pane.setExpanded(true);
      categories.getChildren().add(pane);
    }
    ScrollPane scroll=new ScrollPane(categories); scroll.setFitToWidth(true);scroll.setPrefWidth(330);
    console.setEditable(false);console.setWrapText(true);
    VBox right=new VBox(8,new Label("Live activity / diagnostics"),status,console);
    right.setPadding(new Insets(10));VBox.setVgrow(console,Priority.ALWAYS);
    SplitPane split=new SplitPane(scroll,right);split.setDividerPositions(0.42);
    launchButton=new Button("Launch Claude");launchButton.setOnAction(e->run("Launch"));
    preflightButton=new Button("Run Preflight");preflightButton.setOnAction(e->run("Preflight"));
    Button diag=new Button("Diagnostics");diag.setOnAction(e->run("Diagnostics"));
    Button reset=new Button("Enable all");reset.setOnAction(e->boxes.values().forEach(c->c.setSelected(true)));
    Button stop=new Button("Stop process");stop.setOnAction(e->{Process p=running;if(p!=null && p.isAlive()){p.destroyForcibly();append("Stop requested");}});
    HBox actions=new HBox(8,launchButton,preflightButton,diag,reset,stop);actions.setPadding(new Insets(9));
    VBox app=new VBox(8,new Label("SakhtYar Claude Launcher • Feature settings are saved automatically"),actions,split);
    app.setPadding(new Insets(12));VBox.setVgrow(split,Priority.ALWAYS);
    stage.setTitle("SakhtYar Claude Launcher v2");stage.setScene(new Scene(app,1050,750));stage.show();
    append("Project root: "+root);
    append("Missing legacy launcher is not fatal. Claude CLI is used by the new backend.");
    append("Some checkbox options are advisory/planned; consult README for implemented features.");
    if(!Files.isRegularFile(backend))append("ERROR: Backend missing: "+backend);
    stage.setOnCloseRequest(e->{Process p=running;if(p!=null && p.isAlive())p.destroyForcibly();});
  }
  private Map<String,Boolean> readSettings(){
    try {if(Files.isRegularFile(settings)) return json.readValue(settings.toFile(),new TypeReference<Map<String,Boolean>>(){});}catch(Exception e){append("Settings read error: "+e.getMessage());}
    return new LinkedHashMap<>();
  }
  private synchronized void writeSettings(){
    try{
      Files.createDirectories(settings.getParent());
      Map<String,Boolean> state=new LinkedHashMap<>();boxes.forEach((name,box)->state.put(name,box.isSelected()));
      Path temp=Files.createTempFile(settings.getParent(),"settings-",".tmp");
      json.writerWithDefaultPrettyPrinter().writeValue(temp.toFile(),state);
      try{Files.move(temp,settings,StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING);}
      catch(AtomicMoveNotSupportedException e){Files.move(temp,settings,StandardCopyOption.REPLACE_EXISTING);}
    }catch(Exception e){append("ERROR saving settings: "+e.getMessage());}
  }
  private void run(String action){
    if(running!=null && running.isAlive()){append("Already running; stop that process first.");return;}
    if(!Files.isRegularFile(backend)){append("ERROR: backend not installed: "+backend);return;}
    writeSettings();status.setText("Running: "+action);launchButton.setDisable(true);preflightButton.setDisable(true);
    Thread worker=new Thread(()->{
      try{
        List<String> cmd=List.of("powershell.exe","-NoProfile","-ExecutionPolicy","Bypass","-File",backend.toString(),"-Action",action,"-Root",root.toString(),"-Settings",settings.toString());
        ProcessBuilder builder=new ProcessBuilder(cmd).directory(root.toFile()).redirectErrorStream(true);
        Process p=builder.start();running=p;
        try(BufferedReader reader=new BufferedReader(new InputStreamReader(p.getInputStream(),StandardCharsets.UTF_8))){String line;while((line=reader.readLine())!=null){append(line);}}
        int code=p.waitFor();append("Finished (exit="+code+")");
        Platform.runLater(()->status.setText(action+" exit="+code));
      }catch(Exception e){append("ERROR: "+e.getMessage());Platform.runLater(()->status.setText("Error"));}
      finally{running=null;Platform.runLater(()->{launchButton.setDisable(false);preflightButton.setDisable(false);});}
    },"sakhtyar-worker");worker.setDaemon(true);worker.start();
  }
  private void append(String message){Platform.runLater(()->console.appendText("["+LocalDateTime.now().toLocalTime().withNano(0)+"] "+message+System.lineSeparator()));}
  public static void main(String[] args){launch(args);}
}
