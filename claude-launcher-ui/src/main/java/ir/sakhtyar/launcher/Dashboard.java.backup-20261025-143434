package ir.sakhtyar.launcher;

import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import javafx.application.Application;
import javafx.application.Platform;
import javafx.geometry.Insets;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.*;
import javafx.stage.Stage;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;

public class Dashboard extends Application {
    private final Map<String, List<String>> groups = new LinkedHashMap<>();
    private final Map<String, CheckBox> controls = new LinkedHashMap<>();
    private final ObjectMapper mapper = new ObjectMapper();
    private final TextArea log = new TextArea();
    private final Label status = new Label("Dashboard ready. Network not verified.");
    private Path root, settings;
    private volatile Process active;

    public Dashboard() {
        groups.put("Network and v2rayN", List.of("Check v2rayN process", "Detect HTTP proxy port", "Test proxy HTTPS", "Check German exit IP", "Monitor connection", "Detect proxy leak", "Retry connection", "Set Claude proxy"));
        groups.put("Claude and providers", List.of("Check Claude CLI", "Check authentication", "Check CCR provider", "Select provider profile", "Resume session", "Track usage", "Check versions"));
        groups.put("SakhtYar project", List.of("Verify project path", "Build handoff", "Check CLAUDE.md", "Inspect Git changes", "Protect sensitive files", "Run hooks", "Run Java tests", "Check Java Node and npm"));
        groups.put("Management", List.of("Protect API secrets", "Write logs", "Create diagnostics", "Show Windows notifications", "Avoid duplicate launcher", "Run preflight", "Show dashboard status"));
    }

    @Override
    public void start(Stage stage) {
        String envRoot = System.getenv("SAKHTYAR_PROJECT_ROOT");
        root = (envRoot == null || envRoot.isBlank()) ? Path.of(".").toAbsolutePath().normalize().getParent() : Path.of(envRoot).toAbsolutePath().normalize();
        if (root == null) root = Path.of(".").toAbsolutePath().normalize();
        settings = root.resolve("_claude_launcher").resolve("launcher-settings.json");
        Map<String, Boolean> saved = load();
        VBox sections = new VBox(10);
        sections.setPadding(new Insets(12));
        for (var group : groups.entrySet()) {
            VBox content = new VBox(6);
            content.setPadding(new Insets(8));
            CheckBox all = new CheckBox("Enable all in this category");
            content.getChildren().add(all);
            List<CheckBox> members = new ArrayList<>();
            for (String feature : group.getValue()) {
                CheckBox box = new CheckBox(feature);
                box.setSelected(saved.getOrDefault(feature, true));
                controls.put(feature, box);
                members.add(box);
                content.getChildren().add(box);
                box.selectedProperty().addListener((obs, oldV, newV) -> {
                    all.setSelected(members.stream().allMatch(CheckBox::isSelected));
                    save();
                });
            }
            all.setSelected(members.stream().allMatch(CheckBox::isSelected));
            all.setOnAction(e -> members.forEach(b -> b.setSelected(all.isSelected())));
            TitledPane section = new TitledPane(group.getKey(), content);
            section.setExpanded(true);
            sections.getChildren().add(section);
        }
        Button reset = new Button("Enable all");
        reset.setOnAction(e -> controls.values().forEach(c -> c.setSelected(true)));
        Button launch = new Button("Launch Claude");
        launch.setOnAction(e -> launchClaude());
        Button preflight = new Button("Preflight only");
        preflight.setOnAction(e -> runScript(true));
        Button stop = new Button("Stop launched process");
        stop.setOnAction(e -> {
            Process p = active;
            if (p != null && p.isAlive()) {
                p.destroy();
                append("Stop requested.");
            }
        });
        HBox buttons = new HBox(8, launch, preflight, reset, stop);
        buttons.setPadding(new Insets(12));
        log.setEditable(false);
        log.setPrefRowCount(9);
        VBox outer = new VBox(8, new Label("SakhtYar Claude Launcher — settings are saved automatically"), status, buttons, new ScrollPane(sections), log);
        outer.setPadding(new Insets(12));
        VBox.setVgrow(outer.getChildren().get(3), Priority.ALWAYS);
        stage.setTitle("SakhtYar Claude Launcher");
        stage.setScene(new Scene(outer, 840, 800));
        stage.show();
        append("Project root: " + root);
        append("Checkboxes are configuration preferences; integration with each feature is not implemented yet.");
    }

    private Map<String, Boolean> load() {
        try {
            if (Files.isRegularFile(settings))
                return mapper.readValue(settings.toFile(), new TypeReference<Map<String, Boolean>>() {
                });
        } catch (Exception e) {
            append("Settings read error: " + e.getMessage());
        }
        return new HashMap<>();
    }

    private void save() {
        try {
            Files.createDirectories(settings.getParent());
            Map<String, Boolean> flags = new LinkedHashMap<>();
            controls.forEach((name, box) -> flags.put(name, box.isSelected()));
            Path tmp = Files.createTempFile(settings.getParent(), "launcher-settings-", ".tmp");
            mapper.writerWithDefaultPrettyPrinter().writeValue(tmp.toFile(), flags);
            try {
                Files.move(tmp, settings, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
            } catch (java.nio.file.AtomicMoveNotSupportedException ex) {
                Files.move(tmp, settings, StandardCopyOption.REPLACE_EXISTING);
            }
        } catch (Exception e) {
            append("Settings save failed: " + e.getMessage());
        }
    }

    private void launchClaude() {
        runScript(false);
    }

    private void runScript(boolean preflight) {
        if (active != null && active.isAlive()) {
            append("Launcher already running.");
            return;
        }
        Path script = root.resolve("_claude_launcher").resolve("Start-Claude-Free-Lite.ps1");
        if (!Files.isRegularFile(script)) {
            append("ERROR: Missing existing launcher: " + script);
            return;
        }
        List<String> args = new ArrayList<>(List.of("powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", script.toString()));
        if (preflight) args.add("-PreflightOnly");
        status.setText(preflight ? "Running preflight..." : "Running existing Claude launcher...");
        Thread thread = new Thread(() -> {
            try {
                ProcessBuilder pb = new ProcessBuilder(args).directory(root.toFile()).redirectErrorStream(true);
                Process p = pb.start();
                active = p;
                try (BufferedReader reader = new BufferedReader(new InputStreamReader(p.getInputStream(), StandardCharsets.UTF_8))) {
                    String line;
                    while ((line = reader.readLine()) != null) append(line);
                }
                int code = p.waitFor();
                append("Launcher exit code: " + code);
                Platform.runLater(() -> status.setText("Last launcher exit code: " + code));
            } catch (Exception e) {
                append("ERROR: " + e.getMessage());
                Platform.runLater(() -> status.setText("Launcher failed"));
            } finally {
                active = null;
            }
        }, "sakhtyar-launcher-process");
        thread.setDaemon(true);
        thread.start();
    }

    private void append(String message) {
        Platform.runLater(() -> log.appendText(message + System.lineSeparator()));
    }

    @Override
    public void stop() {
        Process p = active;
        if (p != null && p.isAlive()) p.destroy();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
