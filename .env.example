POSTGRES_DB=sakhtyar
POSTGRES_USER=sakhtyar
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=sakhtyar
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=sakhtyar-documents

APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow_123!
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=مدیر سیستم

# At least 32 random characters; 64+ recommended.
APP_JWT_SECRET=change-this-development-jwt-secret-to-a-long-random-value-1234567890
APP_JWT_EXPIRATION_MINUTES=480

BACKEND_PORT=8080
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Local AI / Ollama
SAKHTYAR_AI_ENABLED=true
SAKHTYAR_AI_PROVIDER=ollama
# If Backend runs directly on Windows/IntelliJ:
OLLAMA_BASE_URL=http://127.0.0.1:11434
# If Backend runs inside Docker Compose, docker-compose.yml overrides this with host.docker.internal.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TEMPERATURE=0.1
# Keep model reasoning traces out of API responses; PersianAgent needs only final JSON.
OLLAMA_THINK=false
OLLAMA_TIMEOUT_SECONDS=90

# Ollama performance tuning (qwen3.5:4b, CPU)
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_MAX_PREDICT_TOKENS=128
OLLAMA_NUM_BATCH=128
# 0 = Java auto-detects physical CPU cores on Windows.
OLLAMA_NUM_THREADS=0
OLLAMA_USE_MMAP=true
# -1 keeps the model loaded while Ollama is running.
OLLAMA_KEEP_ALIVE=-1
OLLAMA_STRUCTURED_SCHEMA=true
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_PRELOAD_MODEL=true
OLLAMA_PRELOAD_TIMEOUT_SECONDS=120
# Java can start/stop the local Ollama server automatically when Backend runs directly on Windows.
OLLAMA_AUTO_START=true
# Current development laptop uses CPU mode because the MX550/CUDA combination crashes Ollama.
OLLAMA_FORCE_CPU=true
OLLAMA_LLM_LIBRARY=cpu_avx2
OLLAMA_NO_CLOUD=true
OLLAMA_STOP_ON_SHUTDOWN=true
OLLAMA_STARTUP_TIMEOUT_SECONDS=30
# Optional absolute path, e.g. C:\Users\you\AppData\Local\Programs\Ollama\ollama.exe
OLLAMA_EXECUTABLE=
